+// SIMMY: a full per-frame buffer (a lot crowded with detailed models) no longer aborts: the push fails
+// (an empty range), the frame is marked overflowed and the rest of its draws are dropped (fifo::draw_prim);
+// logged once per buffer size reached.
+bool g_frameOverflow = false;
+uint64_t g_overflowFrames = 0;
+
+void note_overflow(const ByteBuffer& target, size_t length) {
+  if (!g_frameOverflow) {
+    ++g_overflowFrames;
+    if ((g_overflowFrames & (g_overflowFrames - 1)) == 0)  // 1st, 2nd, 4th, 8th, ... frame
+      Log.warn("frame buffer full ({} bytes used, {} more wanted): the rest of this frame's draws are dropped "
+               "({} frame(s) so far)", target.size(), length, g_overflowFrames);
+  }
+  g_frameOverflow = true;
+}
