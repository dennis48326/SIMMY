+uint32_t aurora_frame_buffer_capacity(int which) {
+  using namespace aurora::gfx;
+  switch (which) {
+  case 0: return static_cast<uint32_t>(VertexBufferSize);
+  case 1: return static_cast<uint32_t>(IndexBufferSize);
+  case 2: return static_cast<uint32_t>(UniformBufferSize);
+  case 3: return static_cast<uint32_t>(StorageBufferSize);
+  default: return 0;
+  }
+}
 float aurora_get_fps() { return aurora::gfx::calculate_fps(); }
