// SimmyLauncher.exe resources: the plumbob icon (made with SimmyLauncher --write-icon, see NOTES in
// README.md) and version information.
#include <windows.h>

1 ICON "simmy_launcher.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "SIMMY Launcher"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "SimmyLauncher"
            VALUE "OriginalFilename", "SimmyLauncher.exe"
            VALUE "ProductName", "SIMMY"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
