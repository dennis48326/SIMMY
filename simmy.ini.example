; SIMMY settings. Copy to simmy.ini next to simmy.exe (the build does this once, and never
; overwrites a simmy.ini that is already there). Everything here is commented out: with no settings
; the game looks exactly like the GameCube, a 4:3 640x480 picture scaled to the window.
;
; Command-line switches override this file: --<setting> <value> or --<setting>=<value>, for example
;   simmy.exe --iso "D:\Games\The Sims 2.iso" --aspect 16:9 --resolution 1080p --msaa 4
; plus --fullscreen, --windowed, --widescreen, --vsync, --novsync and --config <other.ini>.
; Environment (tests): SIMMY_GFX="aspect=16:9;msaa=4", SIMMY_GFX_<SETTING>=value, SIMMY_INI=<file>.
; In the game, F1 opens the options menu: it changes these settings while playing and its "Save to
; simmy.ini" writes them into this file (comments and unknown lines are kept).

[game]

; The game's disc image: a plain GameCube .iso / .gcm of The Sims 2 (any region). SimmyLauncher.exe
; writes this line when you choose the disc; --iso <file> overrides it. The whole rest of the line is
; the path (no comments after it; quotes around it are allowed). Compressed images (.rvz, .wia, .gcz,
; .ciso, NKit) must first be converted in Dolphin: right-click the game, Convert File..., Format ISO.
; (Developers: --data <folder> reads an extracted disc instead and wins over this.)
;iso =

; PC mod: up to 4 players (docs/multiplayer.md). 2 (default) is the GameCube's two-player co-op; 1
; turns co-op off. 3 or 4: in a two-player Free Play game with split = windows, players 3 and 4 press
; Start on their own controller to join, each taking a household sim no player has, with their own
; camera, plumb bob, action menu and window ("SIMMY - Player 3"). Start then A drops out. Story mode
; stays at two players. Environment: SIMMY_PLAYERS=4.
;players = 2

[graphics]

; Window size in pixels (default 1280x960; 1280x720 with aspect=16:9). With fullscreen=exclusive this
; is the display mode to use (default: the desktop's).
;window = 1280x960

; off | borderless | exclusive. Alt+Enter switches between windowed and fullscreen while playing.
;fullscreen = off

; Internal render resolution, independent of the window:
;   auto (default: the window's own pixel size), 480p, 720p, 1080p, 1440p, 2160p,
;   or a factor of the GameCube's 640x480 such as 2x or 3.5x.
; The width follows the aspect: 1080p is 1440x1080 at 4:3 and 1920x1080 at 16:9.
;resolution = auto

; 4:3 (the original) or 16:9 (widescreen: the 3D view is widened to the window's aspect, with the
; same vertical field of view; 16:10 and 21:9 only change the default window size).
; Two-player co-op has its own setting (split, below).
;aspect = 4:3

; Widescreen only: where the Flash HUD and menus go.
;   centered  the 4:3 UI in the middle of the screen
;   edges     HUD elements in the left/right half of the UI move out to the screen edges (default); dialogs
;             and menus across the middle stay centred
;hud = edges

; Multisample anti-aliasing: 1 (off), 2, 4 or 8.
;msaa = 1

; Anisotropic texture filtering: 1 (off) to 16.
;anisotropy = 16

; Wait for the display's refresh: on | off.
;vsync = off

; Frame-rate cap: 60, 30, 20 or 15. The game counts its time in 60 Hz retraces, so it never runs
; faster than 60 frames a second (on a 120/144 Hz display it still runs at normal speed).
;fps_cap = 60

; Graphics API: auto, d3d12, d3d11, vulkan, opengl, opengles (metal on macOS).
;backend = auto

; Filter used to scale the picture to the window: bilinear, or area (sharper when the internal
; resolution is larger than the window).
;resampler = bilinear

; Two-player co-op display (also --split=...):
;   gc       the GameCube's: one 4:3 picture cut in two (default)
;   4x3      two 4:3 halves side by side in one wide window
;   wide     the window's own aspect cut in two
;   windows  each player in their own window, each like a one-player widescreen game: player 1 in
;            the game's window, player 2 in a second window (beside it, or on a second monitor).
;            Closing window 2 hides it (F2 in window 1 shows it again); closing window 1 quits.
;split = gc

; split=windows: player 2's window. Its size (auto: window 1's), its position on the desktop and
; its display (auto: another display than window 1's if there is one, else beside window 1), and
; borderless fullscreen (Alt+Enter in window 2). These are written here when the game quits.
;window2 = auto
;window2_pos = auto
;window2_display = auto
;fullscreen2 = off

; ---- Controls (player 1) ----
; Who controls player 1:
;   auto            keyboard + mouse and the first controller, both (default)
;   keyboard_mouse  keyboard + mouse only; the first controller is then pad 2 (player 2 in co-op)
;   controller      the first controller only (keyboard and mouse do nothing in the game)
;p1_input = auto

; With the mouse cursor control, pushing the mouse against a window edge moves the camera:
; off, on, or fullscreen (only in fullscreen; default).
;mouse_edge_pan = fullscreen

; Camera turning by dragging with the middle (or right) button, and its zoom by dragging up/down:
; speed 0.1 .. 10 (1 = default) and direction. The mouse wheel's zoom speed and direction.
;mouse_rotate_speed = 1
;mouse_invert_x = off
;mouse_invert_y = off
;mouse_zoom_speed = 1
;mouse_invert_wheel = off

; Game: the fire-code meter in buy and build mode. on (default): as on the GameCube, the meter fills
; with the lot's objects and the models they use, warns at two thirds and near full, and refuses new
; objects once it is full. off: the meter stays empty and the lot has no object limit.
;fire_code_limit = on

; Player 1's keys: "action = key, key, ..." ("none" for no key). Key names: a-z, 0-9, f1-f12, space,
; return (enter), kp_enter, escape (esc), backspace, tab, lshift, rshift, shift, lctrl, rctrl, ctrl,
; lalt, ralt, alt, up, down, left, right, pageup, pagedown, home, end, insert, delete, capslock,
; comma, period, slash, semicolon, apostrophe, leftbracket, rightbracket, backslash, minus, equals,
; grave, kp_0-kp_9, kp_plus, kp_minus, kp_multiply, kp_divide, kp_period (or SDL's own key names).
; Keys are by position (a French keyboard's Z key is "w"). Unknown names are reported at start.
; The defaults (remove the ';' to change one):
[keys]
;stick_up = w
;stick_down = s
;stick_left = a
;stick_right = d
;walk = lshift, rshift        ; held with the stick keys: walk (half stick) instead of run
;a = space, return, kp_enter
;b = backspace
;x = f
;y = tab                      ; next sim
;z = c                        ; classic (cursor) control on / off
;start = escape               ; pause menu
;l = q
;r = e
;dpad_up = up
;dpad_down = down
;dpad_left = left
;dpad_right = right
;cstick_up = i                ; zoom in
;cstick_down = k              ; zoom out
;cstick_left = j              ; turn the camera
;cstick_right = l
;pan_up = kp_8                ; move the camera (mouse cursor control only)
;pan_down = kp_2
;pan_left = kp_4
;pan_right = kp_6
